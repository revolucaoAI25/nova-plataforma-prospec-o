# Supabase — crie um projeto NOVO (não reaproveitar o do produto atual)
# Database → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: nunca expor ao cliente — só usada em rotas de servidor
# (admin, criação de usuário, débito de créditos em background).
SUPABASE_SERVICE_ROLE_KEY=

# Casa dos Dados (CNPJ / Receita Federal) — https://casadosdados.com.br
# Chave da plataforma (fallback — o valor cadastrado em /admin → Chaves da
# plataforma tem prioridade). Usuário final nunca configura chave própria.
CDD_API_KEY=

# Google Maps Places API (endpoint legado — ver plano de reconstrução,
# seção 5.4, sobre a migração futura para o endpoint v1). Usada só na
# verificação de CNPJ no Maps. Fallback do que estiver em /admin.
GOOGLE_MAPS_API_KEY=

# URL pública da aplicação (usada em e-mails de convite/redefinição de senha
# e como redirect_uri do OAuth do Google Sheets — precisa ser a URL real em produção)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Apify (api.apify.com) — busca Google Maps, Instagram e LinkedIn.
# Fallback do que estiver em /admin.
APIFY_API_KEY=

# OpenAI da PLATAFORMA — usada só pra montar os planos do onboarding (quem
# paga é a plataforma, não o cliente). O enriquecimento via IA continua na
# chave de cada usuário. Modelo opcional (padrão gpt-5.6-luna). Fallback do /admin.
OPENAI_API_KEY=
ONBOARDING_MODELO_IA=

# Créditos que toda conta de teste recebe ao ser criada (padrão 1000).
# Fallback do que estiver em /admin.
CREDITOS_CONTA_TESTE=

# Créditos de cada teste grátis do cadastro público /teste-gratis (padrão 0).
# Fallback do que estiver em /admin.
CREDITOS_TESTE_GRATIS=

# Google Sheets — OAuth único da plataforma (diferente do produto atual,
# que aceitava client_id/secret por usuário; aqui um client só, o usuário
# apenas autoriza o acesso). Criar em Google Cloud Console → APIs e
# serviços → Credenciais → ID do cliente OAuth 2.0 → Aplicativo da Web.
# URI de redirecionamento autorizado: {NEXT_PUBLIC_APP_URL}/api/integrations/google-sheets/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Evolution API (WhatsApp não-oficial, self-hosted) — usada pelo disparo.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Detecção de resposta: quando um número conecta, a plataforma registra na
# Evolution o webhook {NEXT_PUBLIC_APP_URL}/api/webhooks/evolution (eventos
# MESSAGES_UPSERT = resposta e MESSAGES_UPDATE = entregue/lido), autenticado por um token por instância derivado deste
# segredo. Opcional: sem ele, usa a SUPABASE_SERVICE_ROLE_KEY como base
# (nunca é enviada; só o HMAC). Exige NEXT_PUBLIC_APP_URL preenchida.
WEBHOOK_SECRET=

# Canal oficial do WhatsApp (Business Cloud API) via um provedor que
# espelha o contrato da Meta (ex: DatafyAPI). Só a URL base é global — cada
# instância oficial tem seu próprio token/phone_number_id, provisionados
# manualmente pelo admin em /admin/disparo.
DATAFY_API_BASE_URL=https://cloud.datafyapi.com.br/v1
# Entregue/lido/resposta do canal oficial: cadastre no provedor (ou no app
# da Meta, campo "messages") a URL de callback e o verify token mostrados em
# /admin/disparo ({NEXT_PUBLIC_APP_URL}/api/webhooks/whatsapp-oficial?token=…).
# Só se o webhook vier DIRETO da Meta dá pra validar a assinatura em vez do
# token da URL — aí preencha o App Secret do app da Meta:
WHATSAPP_OFICIAL_APP_SECRET=

# Enriquecimento de Leads via IA — NÃO tem chave de plataforma: feature
# desativada por padrão, liberada por usuário em Admin > usuários, e cada
# usuário cadastra a própria chave OpenAI em Configurações (o custo da IA é
# do usuário, não da plataforma — nada a configurar aqui).

# Resend (https://resend.com) — envio de e-mail para o disparo por e-mail.
# Pré-requisito manual (uma vez, no dashboard da Resend, por domínio que
# for usado em algum remetente cadastrado em /disparo-email): verificar o
# domínio em Domains → Add Domain, configurando os registros DNS
# indicados. Sem isso, todo envio a partir daquele domínio falha.
RESEND_API_KEY=
# Entregue/aberto/clicado/devolvido/spam: no painel da Resend → Webhooks,
# crie um endpoint {NEXT_PUBLIC_APP_URL}/api/webhooks/resend com os eventos
# email.delivered, email.opened, email.clicked, email.bounced e
# email.complained, e cole o "Signing secret" (whsec_…) aqui. Sem ele a rota
# recusa tudo. Abertura e clique só chegam com o rastreio ligado no domínio
# (Domains → Configuration → open/click tracking).
RESEND_WEBHOOK_SECRET=

# Unipile (https://unipile.com) — disparo por LinkedIn (pedido de conexão
# e mensagem, via a conta LinkedIn real do usuário conectada por lá).
# UNIPILE_DSN é a URL específica do seu tenant, informada no dashboard da
# Unipile ao criar a conta (ex: https://apiXXX.unipile.com:XXX). Depois de
# configurar, registre os três webhooks manualmente (uma vez, via
# criarWebhook() em src/lib/integrations/unipile.ts ou pelo dashboard da
# Unipile) apontando pra (troque <segredo> pelo valor de
# UNIPILE_WEBHOOK_SECRET abaixo):
#   {NEXT_PUBLIC_APP_URL}/api/linkedin-dispatch/webhooks/unipile/account-status?secret=<segredo>
#   {NEXT_PUBLIC_APP_URL}/api/linkedin-dispatch/webhooks/unipile/relations?secret=<segredo>
#   {NEXT_PUBLIC_APP_URL}/api/linkedin-dispatch/webhooks/unipile/messages?secret=<segredo>   (fonte "messaging": resposta + message_read/message_delivered)
UNIPILE_DSN=
UNIPILE_API_KEY=

# Segredo compartilhado que os dois endpoints de webhook acima exigem na
# própria URL (?secret=...) — a Unipile não documenta um mecanismo de
# assinatura de payload, então essa é a defesa mínima contra alguém forjar
# um POST pra esses endpoints públicos. Gere um valor aleatório qualquer
# (ex: `openssl rand -hex 24`). Se deixar em branco, os endpoints aceitam
# requisições sem checagem de origem (comportamento antigo).
UNIPILE_WEBHOOK_SECRET=

# BigDataCorp (https://bigdatacorp.com.br) — enriquecimento de leads por
# CNPJ: cadastro, sócios/quadro societário e telefone/e-mail registrados
# da empresa. Chave ÚNICA da plataforma por enquanto (custo absorvido pela
# plataforma, não por usuário — diferente do Enriquecimento via IA). Sem
# essas variáveis, a aba fica visível (se o admin liberar por usuário) mas
# toda execução termina em erro "não configurado".
BIGDATACORP_TOKEN_ID=
BIGDATACORP_ACCESS_TOKEN=

# Asaas (https://asaas.com) — gateway de pagamento pra compra de créditos
# avulsos E assinatura recorrente de plano (/creditos, abas "Créditos
# avulsos" e "Planos"). ASAAS_API_KEY começa com `$aact_hmlg_` (sandbox) ou
# `$aact_prod_` (produção) — a base URL é resolvida automaticamente pelo
# prefixo, sem variável extra. Sem essa variável, a página /creditos mostra
# os pacotes/planos mas os botões de comprar/assinar ficam desabilitados
# com um aviso.
ASAAS_API_KEY=

# Depois de configurar a chave, crie o webhook MANUALMENTE no dashboard do
# Asaas (Configurações → Integrações → Webhooks): URL
# {NEXT_PUBLIC_APP_URL}/api/webhooks/asaas, eventos PAYMENT_CONFIRMED,
# PAYMENT_RECEIVED e PAYMENT_OVERDUE (esse último pra marcar assinatura
# inadimplente quando uma renovação falha), e "Token de autenticação" = o
# mesmo valor abaixo (o Asaas ecoa esse token no header
# `asaas-access-token` de toda entrega — é como validamos que a
# requisição é legítima). Gere um valor aleatório qualquer (ex: `openssl
# rand -hex 24`). Se deixar em branco, o endpoint aceita requisições sem
# checagem de origem (mesmo comportamento de fallback que
# UNIPILE_WEBHOOK_SECRET já tem acima).
ASAAS_WEBHOOK_TOKEN=

# Página de vendas pública (/conheca) — WhatsApp que recebe os contatos dos
# botões, só dígitos com DDI. Em branco, usa o número comercial padrão.
NEXT_PUBLIC_LP_WHATSAPP=
