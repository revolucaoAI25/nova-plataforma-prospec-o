# Supabase — crie um projeto NOVO (não reaproveitar o do produto atual)
# Database → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: nunca expor ao cliente — só usada em rotas de servidor
# (admin, criação de usuário, débito de créditos em background).
SUPABASE_SERVICE_ROLE_KEY=

# Casa dos Dados (CNPJ / Receita Federal) — https://casadosdados.com.br
# Chave padrão da plataforma, usada quando o usuário não tem uma própria
# nem uma administrada individualmente em profiles.cdd_api_key_admin.
CDD_API_KEY=

# Google Maps Places API (endpoint legado — ver plano de reconstrução,
# seção 5.4, sobre a migração futura para o endpoint v1). Usada quando
# o usuário não tem chave própria nem pool configurado.
GOOGLE_MAPS_API_KEY=

# URL pública da aplicação (usada em e-mails de convite/redefinição de senha)
NEXT_PUBLIC_APP_URL=http://localhost:3000
